<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.niftybot.dailyupdate</string>

    <!-- IMPORTANT: replace /Users/abhishekkumar/Desktop/nifty-bot below
         with your actual full path, in BOTH places it appears. -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abhishekkumar/Desktop/nifty-bot/run_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/abhishekkumar/Desktop/nifty-bot</string>

    <!-- Runs every weekday (Mon-Fri) at 19:00 (7pm) local time, after
         NSE has typically published the day's bhavcopy. Change Hour/
         Minute below if you want a different time. Weekday: 1=Monday
         ... 5=Friday (0 and 6 are Sun/Sat, intentionally omitted since
         NSE doesn't publish on weekends anyway). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/niftybot_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/niftybot_launchd_error.log</string>
</dict>
</plist>
